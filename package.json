{
  "name": "mcmonitor-launcher",
  "productName": "MC Monitor Launcher",
  "version": "0.2.5",
  "description": "Minecraft launcher for servers from the MC Monitor catalog",
  "author": "MC Monitor",
  "homepage": "https://mc-mon.ru",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/notices.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "bash scripts/check",
    "icons": "bash scripts/icons",
    "shots": "bash scripts/shots/shots.sh",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && node scripts/nsis-plugin.ts && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@xmcl/client": "3.2.1",
    "@xmcl/core": "2.16.2",
    "@xmcl/installer": "6.3.4",
    "@xmcl/unzip": "2.2.0",
    "@xmcl/user": "4.4.2",
    "bootstrap-icons": "1.13.2",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.11",
    "electron-vite": "5.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "skinview3d": "3.4.2",
    "three": "0.156.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "undici": "7.30.1",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-eslint-parser": "10.4.1",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "@xmcl/unzip": {
      "@xmcl/yauzl": "2.10.0"
    },
    "js-beautify": {
      "nopt": "9.0.0"
    },
    "node-gyp": {
      "undici": "6.29.1"
    },
    "@xmcl/client": {
      "@xmcl/bytebuffer": "0.1.1",
      "@xmcl/nbt": "3.0.2",
      "@xmcl/text-component": "2.1.3"
    }
  }
}
