# Development only: game data folder instead of %LOCALAPPDATA%\MC Monitor\game on Windows
# and <userData>/game on macOS and Linux.
# The packaged launcher ignores this variable.
MCMONITOR_GAME_DIR=

# Development only: 1 registers mcmonitor:// for the dev Electron binary and removes it on exit.
MCMONITOR_DEV_PROTOCOL=

# Development only: 1 leaves the launcher in the tray when its window is closed, as a packaged
# launcher with "start with the system" on does. Without it closing the window quits.
MCMONITOR_DEV_BACKGROUND=

# Smoke mode of a built launcher: needs MCMONITOR_SMOKE=1 and the --smoke argument together
# (scripts/smoke-run sets both). MCMONITOR_SMOKE_REPORT is the JSON report path.
MCMONITOR_SMOKE=
MCMONITOR_SMOKE_REPORT=

# Renderer demo data: on in `npm run dev` unless set to off; in a build only with "on".
# Set to off in .env to see the site API (MCMONITOR_API_BASE) in `npm run dev`.
VITE_LAUNCHER_DEMO=

# Build time: 1 adds the home rows demo page (demo.html) to the renderer build.
VITE_DEMO=

# Behavior telemetry (screens, actions, the 'launcher is open' signal): sent only with "on".
# In `npm run dev` it is read when the launcher starts, in a build it is fixed at build time.
# Release builds turn it on in .github/workflows/release.yml.
MCMONITOR_TELEMETRY_BEHAVIOR=

# Build time: "on" sends a short report when the launcher window itself fails and says so on
# the recovery page and in Privacy. Off by default: the site has no intake for it yet.
MCMONITOR_WINDOW_REPORTS=

# Build time: application (client) ID of the Microsoft Entra app used for the Microsoft sign-in.
# Not a secret: it is visible in the sign-in page address. Empty disables the Microsoft sign-in.
MCMONITOR_MS_CLIENT_ID=

# Development only: launcher API root instead of the production one (https only).
# The packaged launcher always uses the production API and ignores this variable.
MCMONITOR_API_BASE=
# Development only: extra root certificate for Node when the staging site uses its own CA.
NODE_EXTRA_CA_CERTS=
# Development only: 1 asks live status of several servers in one request (GET /servers/live?ids=).
MCMONITOR_LIVE_BATCH=
# Development only: delay in ms for every site API response, to see loading states (scripts/shots).
MCMONITOR_DEBUG_SLOW_MS=

# Device signs check on a live Windows: needs MCMONITOR_DEVICE_REPORT=1 and the
# --device-report=<path> argument together. The launcher writes a JSON report (hashes, timings,
# no raw identifiers) to that path and exits without a window and without any request to the site.
MCMONITOR_DEVICE_REPORT=
