{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["vite/client"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.vue", "src/shared/**/*"],
  "exclude": [
    "src/shared/**/*.test.ts",
    "src/renderer/renderer-rules.test.ts",
    "src/renderer/selection-rules.test.ts"
  ]
}
