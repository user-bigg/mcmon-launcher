{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "electron-vite/node"],
    "lib": ["ES2024"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/renderer-rules.test.ts",
    "src/renderer/selection-rules.test.ts",
    "scripts/**/*.ts"
  ]
}
