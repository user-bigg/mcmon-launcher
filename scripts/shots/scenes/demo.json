    },
    {
      "size": "1440x900"
    },
    {
      "name": "14-demo-home-1440x900",
      "route": "/",
      "wait": ".hero"
    },
    {
      "name": "14-demo-crash-oom-1440x900",
      "route": "/crash/server-103",
