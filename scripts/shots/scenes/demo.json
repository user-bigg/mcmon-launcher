      "wait": ".hero"
    },
    {
      "name": "14-demo-home-scrolled",
      "scroll": "bottom"
    },
    {
      "name": "14-demo-library",
      "route": "/library",
      "wait": ".inst h3"
    },
    {
      "name": "14-demo-library-scrolled",
      "scroll": "bottom"
    },
    {
      "name": "14-demo-crash-oom",
      "route": "/crash/server-103",
